generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum Reason {
  DAMAGED
  WRONG_ITEM
  SIZE_ISSUE
  NOT_AS_DESCRIBED
  CHANGED_MIND
}

enum Resolution {
  REFUND
  REPLACEMENT
  STORE_CREDIT
}

// One row per return request. Customer, order and item are stored as they were
// raised: the brief has no order catalogue, so there is nothing to join to.
model ReturnRequest {
  id            String      @id @default(uuid()) @db.Uuid
  // Generated by the database (see the init migration), never by the client.
  reference     String      @unique @default(dbgenerated("(('RET-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('return_reference_seq'::regclass))::text, 6, '0'::text)"))
  customerName  String
  customerEmail String
  customerPhone String?
  orderNumber   String
  itemSku       String
  itemName      String
  quantity      Int
  reason        Reason
  status        Status      @default(OPEN)
  resolution    Resolution?
  refundAmount  Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  removedAt     DateTime?
  notes         Note[]

  // The partial unique index "one_live_request_per_item" is created in the
  // init migration; Prisma cannot express partial indexes.
  @@index([status])
  @@index([reason])
  @@index([createdAt])
}

model Note {
  id        String        @id @default(uuid()) @db.Uuid
  requestId String        @db.Uuid
  body      String
  createdAt DateTime      @default(now())
  request   ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}
